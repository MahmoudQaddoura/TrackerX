# Copy to .env and adjust for your environment.
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_ISSUER=trackerx
JWT_AUDIENCE=trackerx-web

# SQLite by default. For Postgres: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:////app/data/app.db

# Where uploaded files are stored on disk (used when DOCUMENT_STORAGE=local).
DOCUMENTS_DIR=/app/data/documents

# Object storage. local = on-disk under DOCUMENTS_DIR; s3/minio = S3-compatible.
DOCUMENT_STORAGE=local
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=trackerx-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Backup SQLite and uploaded files together. Keep this outside DOCUMENTS_DIR.
BACKUP_DIR=/app/backups
BACKUP_ON_STARTUP=true
BACKUP_RETENTION_COUNT=14

# Comma-free JSON list of allowed browser origins for CORS.
CORS_ORIGINS=["http://localhost:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
ENVIRONMENT=development
TRACKERX_DEMO_PASSWORD=
