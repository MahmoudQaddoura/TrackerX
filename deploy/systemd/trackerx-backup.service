[Unit]
Description=Create and verify a TrackerX data backup
After=trackerx-backend.service minio.service
Wants=minio.service

[Service]
Type=oneshot
User=blockexe
Group=blockexe
WorkingDirectory=/home/blockexe/TrackerX/projectx-master/projectx-git/backend
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/home/blockexe/TrackerX/projectx-master/projectx-git/backend/.env
ExecStart=/home/blockexe/TrackerX/projectx-master/projectx-git/backend/.venv/bin/python -m app.backup --reason scheduled --keep 14
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/blockexe/TrackerX/projectx-master/projectx-git/backend/data
ReadWritePaths=/home/blockexe/TrackerX/projectx-master/projectx-git/backend/backups
