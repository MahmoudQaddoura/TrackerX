[Unit]
Description=Check TrackerX application readiness
After=network-online.target trackerx-backend.service minio.service
OnFailure=trackerx-recovery.service

[Service]
Type=oneshot
ExecStart=/usr/bin/curl --fail --silent --show-error --connect-timeout 3 --max-time 10 --retry 6 --retry-all-errors --retry-delay 2 --retry-max-time 25 --header "Host: trackerx.defendexe.com" http://127.0.0.1:8000/api/health
