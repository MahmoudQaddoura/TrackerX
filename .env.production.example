# Copy this file to .env on the server. Never commit the real .env file.
ENVIRONMENT=production

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-strong-random-secret

# Used only when the database has no users. The first administrator is required
# to replace this temporary password at first sign-in.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-of-12-or-more-characters
INITIAL_ADMIN_FULL_NAME=TrackerX Administrator

# nginx listens on loopback so a TLS reverse proxy can safely publish it.
TRACKERX_BIND_ADDRESS=127.0.0.1
TRACKERX_HTTP_PORT=8080

# The backup service runs immediately and then once per day by default.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=14

# Keep this restricted to the public TrackerX URL.
CORS_ORIGINS=["https://tracker.example.com"]
ALLOWED_HOSTS=["tracker.example.com"]
